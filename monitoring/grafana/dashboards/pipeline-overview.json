          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(retail_spark_records_total{outcome=\"rejected\"}[5m])) / clamp_min(sum(rate(retail_spark_input_rows_total[5m])), 1e-9)",
