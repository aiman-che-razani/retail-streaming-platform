{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:retail-platform:schema:inventory.events:1",
  "title": "InventoryMovementRecorded",
  "description": "One stock movement for one SKU at one store. Topic: inventory.events. Key: store_id:product_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "payload"],
  "properties": {
    "metadata": {
      "allOf": [
        { "$ref": "#/definitions/metadata" },
        { "properties": { "event_type": { "enum": ["inventory.movement.recorded"] } } }
      ]
    },
    "payload": { "$ref": "#/definitions/payload" }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "schema_version", "event_timestamp", "produced_at", "producer", "correlation_id"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Globally unique event identifier; the platform-wide deduplication key." },
        "event_type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" },
        "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$", "description": "Contract version MAJOR.MINOR; major pinned to 1 by this schema." },
        "event_timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "description": "Event time (UTC): when the business fact happened." },
        "produced_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "description": "When the producer serialized the event (UTC)." },
        "producer": { "type": "string", "pattern": "^[a-z0-9-]{1,50}/[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "causation_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movement_id", "store_id", "product_id", "movement_type", "quantity_delta", "quantity_on_hand_after", "reason_code", "reference_id", "unit_cost"],
      "properties": {
        "movement_id": { "type": "string", "pattern": "^MOV-[A-Z0-9-]{4,40}$" },
        "store_id": { "type": "string", "pattern": "^[A-Z]{2,6}-[0-9]{2}$" },
        "product_id": { "type": "string", "pattern": "^SKU-[0-9]{5}$" },
        "movement_type": { "type": "string", "enum": ["RECEIPT", "SALE", "ADJUSTMENT"] },
        "quantity_delta": { "type": "integer", "minimum": -100000, "maximum": 100000, "not": { "const": 0 } },
        "quantity_on_hand_after": { "type": "integer", "minimum": -100000, "maximum": 1000000 },
        "reason_code": {
          "type": ["string", "null"],
          "enum": ["REPLENISHMENT", "POS_SALE", "DAMAGED", "EXPIRED", "SHRINKAGE", "STOCK_COUNT_CORRECTION", null]
        },
        "reference_id": { "type": ["string", "null"], "pattern": "^(PO|TXN)-[A-Z0-9-]{4,40}$" },
        "unit_cost": { "type": ["number", "null"], "minimum": 0, "maximum": 100000 }
      }
    }
  }
}
