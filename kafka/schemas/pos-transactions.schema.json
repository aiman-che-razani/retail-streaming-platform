{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:retail-platform:schema:pos.transactions:1",
  "title": "PosTransactionCompleted",
  "description": "A completed point-of-sale checkout (basket) at one store. Topic: pos.transactions. Key: store_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "payload"],
  "properties": {
    "metadata": {
      "allOf": [
        { "$ref": "#/definitions/metadata" },
        { "properties": { "event_type": { "enum": ["pos.transaction.completed"] } } }
      ]
    },
    "payload": { "$ref": "#/definitions/payload" }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "schema_version", "event_timestamp", "produced_at", "producer", "correlation_id"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Globally unique event identifier; the platform-wide deduplication key." },
        "event_type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" },
        "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$", "description": "Contract version MAJOR.MINOR; major pinned to 1 by this schema." },
        "event_timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "description": "Event time (UTC): when the business fact happened." },
        "produced_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$", "description": "When the producer serialized the event (UTC)." },
        "producer": { "type": "string", "pattern": "^[a-z0-9-]{1,50}/[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "causation_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    },
    "money": { "type": "number", "minimum": 0, "maximum": 100000 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "store_id", "register_id", "customer_id", "payment_method", "currency", "line_items", "total_amount"],
      "properties": {
        "transaction_id": { "type": "string", "pattern": "^TXN-[A-Z0-9-]{4,40}$" },
        "store_id": { "type": "string", "pattern": "^[A-Z]{2,6}-[0-9]{2}$" },
        "register_id": { "type": "string", "pattern": "^REG-[0-9]{2}$" },
        "customer_id": { "type": ["string", "null"], "pattern": "^CUST-[0-9]{7}$", "description": "null = guest checkout" },
        "payment_method": { "type": "string", "enum": ["CASH", "CARD", "EWALLET"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "line_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_number", "product_id", "quantity", "unit_price", "discount_amount"],
            "properties": {
              "line_number": { "type": "integer", "minimum": 1 },
              "product_id": { "type": "string", "pattern": "^SKU-[0-9]{5}$" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 999 },
              "unit_price": { "$ref": "#/definitions/money" },
              "discount_amount": { "$ref": "#/definitions/money" }
            }
          }
        },
        "total_amount": { "type": "number", "minimum": 0 }
      }
    }
  }
}
