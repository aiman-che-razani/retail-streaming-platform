# =============================================================================
# Retail streaming platform — configuration template.
#   cp .env.example .env      then fill in the CHANGE_ME values.
# .env is git-ignored. NEVER commit real credentials.
# Values here are for LOCAL DEVELOPMENT. Production uses a secrets manager (see README).
# =============================================================================

# ----------------------------------------------------------------------------- logging
LOG_LEVEL=INFO
# json (machine-parseable, default) | console (human-friendly for local debugging)
LOG_FORMAT=json

# ----------------------------------------------------------------------------- Kafka
# Host-side address. Containers override this with kafka:29092 in docker-compose.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
# PLAINTEXT locally; SASL_SSL with KAFKA_SASL_* in real deployments
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# local (RF=1) | production (RF=3, min.insync.replicas=2) — see kafka/config/topics.yaml
KAFKA_ENVIRONMENT_PROFILE=local
KAFKA_DELIVERY_TIMEOUT_MS=120000
KAFKA_LINGER_MS=20
KAFKA_COMPRESSION_TYPE=zstd

# ----------------------------------------------------------------------------- simulator
SIMULATOR_SEED=42
# realtime (current timestamps, paced) | backfill (historical days, max speed)
SIMULATOR_MODE=realtime
SIMULATOR_TRANSACTIONS_PER_SECOND=20
SIMULATOR_BACKFILL_DAYS=7
SIMULATOR_PRODUCT_COUNT=500
SIMULATOR_CUSTOMER_COUNT=20000
SIMULATOR_GUEST_CHECKOUT_RATIO=0.4
# 0 = run until stopped
SIMULATOR_MAX_EVENTS=0
# Fault injection: probability per generated event (0.0 - 1.0). Try 0.01 each to see DLQ handling.
SIMULATOR_MALFORMED_RATE=0.0
SIMULATOR_MISSING_FIELD_RATE=0.0
SIMULATOR_INVALID_VALUE_RATE=0.0
SIMULATOR_DUPLICATE_RATE=0.0
SIMULATOR_LATE_EVENT_RATE=0.0
SIMULATOR_LATE_EVENT_MAX_MINUTES=120
SIMULATOR_UNKNOWN_PRODUCT_RATE=0.0

# ----------------------------------------------------------------------------- Spark
SPARK_INGEST_TRIGGER_SECONDS=30
SPARK_REALTIME_TRIGGER_SECONDS=10
SPARK_WATERMARK_MINUTES=10
SPARK_INGEST_MAX_OFFSETS_PER_TRIGGER=50000
SPARK_REALTIME_MAX_OFFSETS_PER_TRIGGER=20000

# ----------------------------------------------------------------------------- PostgreSQL (real-time store)
POSTGRES_DB=retail_realtime
POSTGRES_HOST_PORT=5434
POSTGRES_ADMIN_USER=retail_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_admin
# Used by the Spark realtime app (role spark_writer) and Grafana (role grafana_reader)
POSTGRES_SPARK_PASSWORD=CHANGE_ME_spark
POSTGRES_GRAFANA_PASSWORD=CHANGE_ME_grafana
# Host-side connection used by tests/tools (containers override host/port/user)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=spark_writer
POSTGRES_PASSWORD=CHANGE_ME_spark

# ----------------------------------------------------------------------------- Grafana
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin

# ----------------------------------------------------------------------------- Snowflake
# Leave SNOWFLAKE_ACCOUNT empty to run everything except the warehouse path.
# Account identifier: <orgname>-<account_name> (Admin > Accounts > "Account identifier").
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=RETAIL_DEV
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=RETAIL_PIPELINE_WH

# --- Service user for the loader (preferred: key-pair authentication, see docs/runbooks/snowflake-setup.md)
SNOWFLAKE_USER=RETAIL_LOADER_SVC
SNOWFLAKE_ROLE=RETAIL_LOADER
# Host path (used by host-side commands) ...
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_loader_key.p8
# ... and the same file as seen inside the loader container (./secrets is mounted read-only)
SNOWFLAKE_PRIVATE_KEY_PATH_CONTAINER=/app/secrets/snowflake_loader_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=CHANGE_ME_key_passphrase

# --- DEV ONLY: password auth for an interactive user (e.g. running migrations as RETAIL_ADMIN).
# Leave empty when using key-pair auth. Long-lived passwords are the weakest option.
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# ----------------------------------------------------------------------------- loader
# 900 s = 15 min: Snowflake cost vs freshness trade-off (ADR-005). 3600 cuts cost ~4x.
LOADER_INTERVAL_SECONDS=900
LOADER_ARCHIVE_RETENTION_DAYS=3
LOADER_STAGE_RETENTION_DAYS=7
